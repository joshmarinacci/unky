{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "browser-pages-capability",
  "description": "Allows remote browser pages to request safe new tabs and report same-origin URL changes.",
  "webviews": ["page-*"],
  "remote": {
    "urls": ["http://*:*/*", "https://*:*/*", "http://127.0.0.1:4179/*"]
  },
  "permissions": ["allow-open-link-in-new-tab", "allow-open-link-in-new-window", "allow-open-link-in-tab-folder", "allow-get-tab-folders", "allow-sync-page-url", "allow-focus-browser-tab", "allow-get-external-browsers", "allow-open-in-external-browser"]
}
