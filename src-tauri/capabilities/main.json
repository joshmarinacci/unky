{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Privileges for the trusted browser UI only",
  "webviews": [
    "main",
    "browser-window-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "allow-main-browser-commands"
  ]
}
