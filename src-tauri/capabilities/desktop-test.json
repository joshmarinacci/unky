{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-test-capability",
  "description": "Debug-only WebdriverIO capabilities for the trusted browser window.",
  "windows": ["main", "wdio-host"],
  "permissions": [
    "allow-main-browser-commands",
    "allow-desktop-test-inspect-page",
    "allow-desktop-test-inspect-tab-drag-overlay",
    "allow-desktop-test-browser-ui",
    "wdio:default",
    "wdio-webdriver:default"
  ]
}
