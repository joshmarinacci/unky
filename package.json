{
  "name": "my-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri-dev": "npm run tauri -- dev",
    "build": "tsc -b && vite build",
    "check": "npm run build && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "preview": "vite preview",
    "clean": "rm -rf dist test-results node_modules/.tmp && cargo clean",
    "tauri": "tauri",
    "tauri-release": "npm run build:metadata && npm run tauri -- build --bundles dmg",
    "build:metadata": "node scripts/build-metadata.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "sign-mac": "bash scripts/sign-mac.sh",
    "build:installer": "npm run tauri -- build --bundles nsis",
    "test:unit": "node --import tsx --test tests/bookmark-tree.test.ts",
    "test:desktop": "node tests/desktop/run.mjs",
    "test:desktop:real-sites": "MY_BROWSER_REAL_SITE_TESTS=1 node tests/desktop/run.mjs --spec tests/desktop/specs/real-sites.spec.ts",
    "publish-dmg": "scp -i ../deployman_private.key target/release/bundle/dmg/*.dmg deployman@josh.earth:/sites/apps.josh.earth/my-browser/",
    "publish-site": "scp -i ../deployman_private.key -r site/* deployman@josh.earth:/sites/apps.josh.earth/my-browser/"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.4.2",
    "lucide-react": "^1.61.0",
    "react": "19.1.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.8.4",
    "@types/node": "26.6.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.2.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.5.1",
    "@wdio/tauri-service": "^1.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.2",
    "vite": "8.3.3"
  }
}
