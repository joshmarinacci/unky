{
  "name": "my-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri-dev": "npm run tauri -- dev",
    "build": "tsc -b && vite build",
    "check": "npm run build && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri-release":"npm run tauri -- build --bundles dmg",
    "build:installer": "npm run tauri -- build --bundles nsis",
    "test:desktop": "node tests/desktop/run.mjs",
    "publish-dmg":"scp -i ../deployman_private.key target/release/bundle/dmg/*.dmg deployman@josh.earth:/sites/apps.josh.earth/my-browser/",
    "publish-site":"scp -i ../deployman_private.key -r site/* deployman@josh.earth:/sites/apps.josh.earth/my-browser/"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "lucide-react": "^1.61.0",
    "react": "19.1.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.8.4",
    "@types/node": "26.6.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.5.1",
    "@wdio/tauri-service": "^1.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.2",
    "vite": "8.3.3"
  }
}
