#!/bin/bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage: mybrowser [--private] <url>" >&2
  exit 2
fi

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P -- "$(dirname -- "$script_path")" && pwd)"
  target="$(readlink "$script_path")"
  if [[ "$target" = /* ]]; then script_path="$target"; else script_path="$script_dir/$target"; fi
done
script_dir="$(cd -P -- "$(dirname -- "$script_path")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

if [[ -n "${MY_BROWSER_BIN:-}" ]]; then
  browser_bin="$MY_BROWSER_BIN"
elif [[ -x "$repo_root/target/release/bundle/macos/My Browser.app/Contents/MacOS/my-browser" ]]; then
  browser_bin="$repo_root/target/release/bundle/macos/My Browser.app/Contents/MacOS/my-browser"
elif [[ -x "$repo_root/target/debug/my-browser" ]]; then
  browser_bin="$repo_root/target/debug/my-browser"
elif [[ -x "/Applications/My Browser.app/Contents/MacOS/my-browser" ]]; then
  browser_bin="/Applications/My Browser.app/Contents/MacOS/my-browser"
else
  browser_bin="/Applications/My Browser.app/Contents/MacOS/my-browser"
fi

if [[ ! -x "$browser_bin" ]]; then
  echo "My Browser executable not found at: $browser_bin" >&2
  echo "Install My Browser in /Applications or set MY_BROWSER_BIN to its executable." >&2
  exit 1
fi

nohup "$browser_bin" "$@" </dev/null >/dev/null 2>&1 &
