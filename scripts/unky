#!/bin/bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P -- "$(dirname -- "$script_path")" && pwd)"
  target="$(readlink "$script_path")"
  if [[ "$target" = /* ]]; then script_path="$target"; else script_path="$script_dir/$target"; fi
done
script_dir="$(cd -P -- "$(dirname -- "$script_path")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

# Releases before the rename shipped the executable as Contents/MacOS/my-browser.
candidates=(
  "$repo_root/target/release/bundle/macos/Unky.app/Contents/MacOS/unky"
  "$repo_root/target/debug/unky"
  "/Applications/Unky.app/Contents/MacOS/unky"
  "/Applications/Unky.app/Contents/MacOS/my-browser"
)
browser_bin="${UNKY_BIN:-${MY_BROWSER_BIN:-}}"
if [[ -z "$browser_bin" ]]; then
  browser_bin="/Applications/Unky.app/Contents/MacOS/unky"
  for candidate in "${candidates[@]}"; do
    if [[ -x "$candidate" ]]; then
      browser_bin="$candidate"
      break
    fi
  done
fi

if [[ ! -x "$browser_bin" ]]; then
  echo "Unky executable not found at: $browser_bin" >&2
  echo "Install Unky in /Applications or set UNKY_BIN to its executable." >&2
  exit 1
fi

nohup "$browser_bin" "$@" </dev/null >/dev/null 2>&1 &
